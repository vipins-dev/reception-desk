{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/petclinic/:path*",
      "destination": "https://REPLACE-WITH-YOUR-BACKEND-HOST/petclinic/:path*"
    },
    {
      "source": "/((?!petclinic/).*)",
      "destination": "/index.html"
    }
  ]
}
